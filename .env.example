# Example environment for the nest-realtime-example stack.
#
# Copy this file to .env and adjust as needed. Every value here is a local
# development placeholder, never a real credential. The api reads these through
# its typed config module, which validates and defaults each variable at boot.

# --- api (apps/api) ---

# Instance HTTP port. Use 3002 for the second cluster instance.
PORT=3001

# Instance label shown in the cluster lab counters and the audit feed.
INSTANCE_NAME=app-a

# Boot transport profile: sse | websocket | both.
REALTIME_TRANSPORT=sse

# SSE endpoint path, overridden from the library default to prove it is configurable.
REALTIME_SSE_ENDPOINT=/api/events

# Heartbeat interval in milliseconds. Lowered for a livelier local stream.
REALTIME_HEARTBEAT_MS=10000

# Replay buffer size. Kept small so replay labs evict observably.
REALTIME_REPLAY_BUFFER_SIZE=10

# Maximum concurrent connections per user. Kept small so eviction is observable.
REALTIME_MAX_CONNECTIONS_PER_USER=2

# Whether the library emits the connection:established event: true | false.
REALTIME_EMIT_CONNECTION_EVENT=true

# WebSocket namespace, set away from the default to prove it is config-driven.
REALTIME_WS_NAMESPACE=/live

# WebSocket max buffer size in bytes. Kept small to trigger the payload lab.
REALTIME_WS_MAX_BUFFER_BYTES=16384

# Reauthentication interval in seconds. Short so the reauth cycle is observable.
REAUTH_INTERVAL_SECONDS=15

# Behavior on reauthentication failure: disconnect | event.
REAUTH_ON_FAILURE=disconnect

# Positive-reauth cache TTL in ms. Keep at or below REAUTH_INTERVAL_SECONDS*1000
# so a revocation is caught on the next cycle; 0 re-checks every cycle.
REAUTH_CACHE_TTL_MS=10000

# Redis connection URL for the bus, tickets, offline queue and presence.
REDIS_URL=redis://localhost:6379

# Pub/sub driver: memory (single instance) | redis (cluster profile).
PUBSUB_DRIVER=memory

# HMAC key for the demo session cookies. Override with a strong secret outside local dev.
SESSION_SECRET=insecure-dev-session-secret-change-me

# Browser origin allowed by the SSE and WebSocket CORS policy.
WEB_ORIGIN=http://localhost:3000

# --- web (apps/web) ---

# Base URL the browser uses to reach the api.
NEXT_PUBLIC_API_URL=http://localhost:3001

# WebSocket URL the browser uses for the WS transport.
NEXT_PUBLIC_WS_URL=ws://localhost:3001/live
