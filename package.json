{
  "name": "nest-realtime-example",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical reference implementation of @bymax-one/nest-realtime.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "lint": "pnpm -r --workspace-concurrency=1 run lint",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:e2e:cluster": "docker compose --profile cluster up -d --build && pnpm --filter @nest-realtime-example/api run test:e2e:cluster; status=$?; docker compose --profile cluster down; exit $status",
    "test:e2e:cluster:ws": "REALTIME_TRANSPORT=websocket docker compose --profile cluster up -d --build && pnpm --filter @nest-realtime-example/api run test:e2e:cluster:ws; status=$?; docker compose --profile cluster down; exit $status",
    "test:e2e:all": "sh scripts/e2e-all.sh",
    "audit:exports": "node scripts/audit-exports.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "commitlint": "commitlint",
    "mutation": "pnpm --filter @nest-realtime-example/api run mutation"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
